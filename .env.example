# ==============================================================================
# AI-Driven Creative Clustering — Environment Configuration Template
# Copy this file to `.env` and adjust the variables as needed.
# ==============================================================================

# --- Google Cloud Platform ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BQ_LOCATION=US

# --- BigQuery Source & Output ---
SOURCE_TABLE=ad_intelligence.creative_occurrences_all_markets
BQ_DATASET=creative_theme_analytics

# --- Advertiser & Extraction Filters (Default Showcase: Malaysia Telco - Maxis) ---
ADVERTISER_NAMES=MAXIS,MAXIS BROADBAND,HOTLINK,MAXIS BUSINESS
ADVERTISER_NAME=Maxis
COUNTRY=Malaysia
START_DATE=2026-01-01
END_DATE=2026-03-31

# --- Google Cloud Storage ---
GCS_BUCKET=creative-analytics-staging-bucket
GCS_PREFIX=malaysia-telco-clustering

# --- Local Storage Paths ---
# Directory where media files and extracted frames are staged locally
STAGE_DIR=assets
# Directory where intermediate CSV / NPZ files are saved
DATA_DIR=ingestion/data

# --- Clustering Hyperparameters ---
CLUSTERING_TRACK=frame
CLUSTERING_VISUAL_WEIGHT=0.3
CLUSTERING_MIN_CLUSTER_SIZE=4
CLUSTERING_MIN_SAMPLES=2
CLUSTERING_UMAP_COMPONENTS=30
CLUSTERING_UMAP_SEED=42
CLUSTERING_MERGE_THRESHOLD=0.94

# --- Models ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Optional Cloud API Keys (for live multimodal embeddings & concept extraction) ---
# GEMINI_API_KEY=your-gemini-api-key
